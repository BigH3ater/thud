<?xml version="1.0" encoding="utf-8"?>
<!-- Kodiak metric tile: warm surface with a left accent bar in @color/kdk_green. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kdk_green" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/kdk_surface2" />
            <corners android:topRightRadius="12dp" android:bottomRightRadius="12dp" />
        </shape>
    </item>
</layer-list>
