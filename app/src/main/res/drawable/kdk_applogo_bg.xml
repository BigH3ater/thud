<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded mask for app-logo initials; the per-app color is set via android:background
     color on the TextView, but this gives the launcher tiles a rounded inner frame. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/kdk_surface" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/kdk_line" />
</shape>
