<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================== HUD Box Styles ==================== -->

    <!-- Base style for all HUD boxes -->
    <style name="HudBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/box_padding</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Interactive box (Pace, Incline) - touchable -->
    <style name="HudBox.Interactive">
        <item name="android:background">@color/box_interactive</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Data box (Time) - display only -->
    <style name="HudBox.Data">
        <item name="android:background">@color/box_data</item>
    </style>

    <!-- Heart Rate box -->
    <style name="HudBox.HeartRate">
        <item name="android:background">@color/box_heart_rate</item>
    </style>

    <!-- Service buttons box -->
    <style name="HudBox.Service">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_weight">0</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@color/box_service</item>
    </style>

    <!-- ==================== Text Styles ==================== -->

    <!-- Base text style -->
    <style name="HudText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- Label text (PACE, INCLINE, etc.) -->
    <style name="HudText.Label">
        <item name="android:textColor">@color/text_label</item>
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <!-- Label text dimmed -->
    <style name="HudText.Label.Dim">
        <item name="android:textColor">@color/text_label_dim</item>
    </style>

    <!-- Value text (main numbers). Width is match_parent + centered so autosize has a
         width bound to shrink against: at 5 tiles the long values (0.00, 0:00, and
         times past an hour like 1:02:34) no longer fit 60sp, so uniform autosize
         scales each number down to its tile instead of ellipsizing ("0....", "0:..."). -->
    <style name="HudText.Value">
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_value</item>
        <item name="android:textStyle">bold</item>
        <!-- maxLines, not singleLine: singleLine + autosize falls back to ellipsizing. -->
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">18sp</item>
        <item name="android:autoSizeMaxTextSize">@dimen/text_value</item>
        <item name="android:autoSizeStepGranularity">2sp</item>
    </style>

    <!-- Unit text (min/km, grade, etc.) -->
    <style name="HudText.Unit">
        <item name="android:textColor">@color/text_label</item>
        <item name="android:textSize">@dimen/text_unit</item>
    </style>

    <!-- ==================== Button Styles ==================== -->

    <!-- Base button style -->
    <style name="HudButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- ==================== Kodiak launcher styles ==================== -->
    <style name="KdkGroupLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/kdk_ember</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="KdkAppRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="KdkAppTile">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/kdk_tile_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="KdkAppLogo">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/kdk_paper</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="KdkAppName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/kdk_paper</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Service button (text-based) -->
    <style name="HudButton.Close">
        <item name="android:layout_width">@dimen/service_button_width</item>
        <item name="android:layout_height">@dimen/service_button_height</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_close_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/service_button_border</item>
    </style>

    <!-- kdk bottom control bar (kiosk backdrop): Start / Stop / Resume / Previous -->
    <style name="KdkControlButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/kdk_control_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/kdk_control_gap</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">@drawable/kdk_tile_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">14sp</item>
        <item name="android:autoSizeMaxTextSize">22sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>
</resources>
